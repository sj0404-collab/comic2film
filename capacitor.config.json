{
  "appId": "com.voicecomic.app",
  "appName": "VoiceComic",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "overrideUserAgent": "VoiceComic/1.0"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}